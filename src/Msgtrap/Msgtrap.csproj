<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>msgtrap</AssemblyName>
    <RootNamespace>Msgtrap</RootNamespace>

    <!-- Ships as a global tool so `msgtrap` runs from any directory. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>msgtrap</ToolCommandName>
    <PackageId>msgtrap</PackageId>
    <Version>0.4.0</Version>
    <Authors>Msgtrap</Authors>
    <Description>Local SMS and email trap for development. Emulates Arkesel, Hubtel, Twilio and mNotify SMS APIs plus an SMTP listener, and shows every message in one web UI.</Description>
    <PackageTags>sms;smtp;email;arkesel;hubtel;twilio;mnotify;testing;dev-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts</PackageOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    `dotnet publish -c Release -r win-x64` produces a single self-contained
    msgtrap.exe in artifacts\win-x64 that runs with no .NET install, like Mailpit.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\artifacts\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the repo README and licence inside the NuGet package. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI is embedded so the packaged tool is a single, self-contained unit. -->
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

</Project>
